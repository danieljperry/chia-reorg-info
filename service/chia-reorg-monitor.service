# chia-reorg-monitor.service — systemd user service for the re-org monitor.
#
# Install (no root required):
#
#   1. Edit the three angle-bracket placeholders below: <node-bin> (output of
#      `which node`), <install-path> (absolute path to your chia-reorg-info
#      checkout), and <smtp-env-file>. Customize --recipient as needed.
#   2. mkdir -p ~/.config/systemd/user
#   3. cp service/chia-reorg-monitor.service ~/.config/systemd/user/
#   4. systemctl --user daemon-reload
#   5. systemctl --user enable --now chia-reorg-monitor
#   6. Logs:
#        journalctl --user -u chia-reorg-monitor -f   (stderr mirror)
#        tail -f ~/logs/reorg_monitor.log             (the monitor's log)
#
# Stop / uninstall:
#   systemctl --user disable --now chia-reorg-monitor
#   rm ~/.config/systemd/user/chia-reorg-monitor.service
#   systemctl --user daemon-reload
#
# Notes:
#   - User services stop at logout by default. To keep the monitor running
#     while logged out: `sudo loginctl enable-linger $USER`.
#   - systemd does not expand $HOME or ~ inside ExecStart. Use absolute paths.

[Unit]
Description=chia-reorg-info re-org monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=<node-bin> <install-path>/dist/index.js reorg_monitor \
  --network mainnet \
  --recipient you@example.com:1 \
  --smtp-env-file <smtp-env-file>
# To use the local DB or both sources, add e.g.:
#   --source both \
#   --db-path /home/<you>/.chia/mainnet/db/blockchain_v2_mainnet.sqlite \
# Use an ABSOLUTE path: systemd does not expand ~ or $HOME in ExecStart.
# This is a user-mode service so it runs as your UID and has access to your
# home directory; if you switch to the system-level template, see its notes
# on parent-dir permissions and ProtectHome=true hiding /home.
Restart=on-failure
RestartSec=10

# Hardening directives are not set here. Even mild ones like
# NoNewPrivileges=true can fail this unit with status=218/CAPABILITIES
# under `systemctl --user` on some systemd/kernel combinations, because
# they require CAP_SETPCAP to manipulate the bounding set and a
# user-mode systemd doesn't have it. If you want defence-in-depth, the
# right path is to install this as a SYSTEM-level service
# (/etc/systemd/system/, ExecStart with User=chia-reorg, etc.) — then
# PID 1 systemd has the caps it needs and the hardening directives
# will apply correctly. See examples in the systemd.exec(5) man page.

[Install]
WantedBy=default.target
