{
  "name": "chia-reorg-info",
  "version": "0.1.0",
  "description": "Tools for detecting and analysing Chia blockchain re-organisations. No MCP dependency.",
  "type": "module",
  "license": "MIT",
  "author": "Spacetime Technology",
  "keywords": [
    "chia",
    "blockchain",
    "reorg",
    "monitoring",
    "coinset"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljperry/chia-reorg-info.git"
  },
  "homepage": "https://github.com/danieljperry/chia-reorg-info#readme",
  "bugs": {
    "url": "https://github.com/danieljperry/chia-reorg-info/issues"
  },
  "bin": {
    "chia-reorg-info": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "scripts/**/*",
    "service/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "chia-agent": "^14.3.1",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
